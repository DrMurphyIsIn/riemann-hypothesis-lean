/-- Every real matrix in the box has the quadratic floor (cS - ρ)/S, ρ = m (w + 2^(bE-1)). -/
theorem floor (G : Fin 583 → Fin 583 → ℝ)
    (hbox : ∀ i j : Fin 583, |G i j - (Mz D i j : ℝ) / (2 : ℝ) ^ 104| ≤ ((3 : ℕ) : ℝ) / (2 : ℝ) ^ 104) (x : Fin 583 → ℝ) :
    (((46210957958236816433240021 : ℤ) - 21004788662055995093 : ℤ) : ℝ) / (2 : ℝ) ^ 104 * ∑ i, x i ^ 2 ≤ ∑ i, ∑ j, x i * G i j * x j :=
  pgc_floor D hp hall 3 21004788662055995093 (by decide +kernel) _ (by positivity) G hbox x

/-- The published floor 227837e-11 (rounded down). -/
theorem floor_pub (G : Fin 583 → Fin 583 → ℝ)
    (hbox : ∀ i j : Fin 583, |G i j - (Mz D i j : ℝ) / (2 : ℝ) ^ 104| ≤ ((3 : ℕ) : ℝ) / (2 : ℝ) ^ 104) (x : Fin 583 → ℝ) :
    ((227837 : ℝ) / 100000000000) * ∑ i, x i ^ 2 ≤ ∑ i, ∑ j, x i * G i j * x j := by
  refine le_trans ?_ (floor G hbox x)
  have hx : 0 ≤ ∑ i, x i ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg (x i))
  have hc : (227837 : ℝ) / 100000000000 ≤ (((46210957958236816433240021 : ℤ) - 21004788662055995093 : ℤ) : ℝ) / (2 : ℝ) ^ 104 := by norm_num
  exact mul_le_mul_of_nonneg_right hc hx

