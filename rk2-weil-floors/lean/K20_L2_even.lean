    (hbox : ∀ i j : Fin 583, |G i j - (Mz D i j : ℝ) / (2 : ℝ) ^ 124| ≤ ((3 : ℕ) : ℝ) / (2 : ℝ) ^ 124) (x : Fin 583 → ℝ) :
