  have hc : (228468 : ℝ) / 100000000000000 ≤ (((48589912800577357403542631021 : ℤ) - 10754451794972668593877 : ℤ) : ℝ) / (2 : ℝ) ^ 124 := by norm_num
  exact mul_le_mul_of_nonneg_right hc hx

